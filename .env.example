# ==============================================================================
# Supabase Configuration
# ==============================================================================
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# ==============================================================================
# Cashfree Payments Configuration
# Mode: Begin with sandbox test credentials
# ==============================================================================
CASHFREE_APP_ID=your_cashfree_app_id
CASHFREE_SECRET_KEY=your_cashfree_secret_key
CASHFREE_ENV=sandbox
NEXT_PUBLIC_CASHFREE_ENV=sandbox
CASHFREE_API_VERSION=2023-08-01
CASHFREE_WEBHOOK_SECRET=your_cashfree_webhook_secret

# ==============================================================================
# Razorpay Payment Gateway Configuration (Legacy / Fallback)
# Mode: Begin with test mode credentials (rzp_test_...)
# ==============================================================================
# Public Key ID exposed to browser to launch Razorpay Checkout modal
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_your_test_key_id

# Server-side Key ID (Must match the public Key ID above)
RAZORPAY_KEY_ID=rzp_test_your_test_key_id

# Server-side Key Secret (CRITICAL: Server-only, NEVER prefix with NEXT_PUBLIC)
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# Server-side Webhook Secret for HMAC verification at /api/webhooks/razorpay
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# ==============================================================================
# LiveKit WebRTC Configuration (Streaming & Voice)
# ==============================================================================
NEXT_PUBLIC_LIVEKIT_URL=wss://your-livekit-domain.livekit.cloud
LIVEKIT_URL=wss://your-livekit-domain.livekit.cloud
LIVEKIT_API_KEY=your_livekit_api_key
LIVEKIT_API_SECRET=your_livekit_api_secret

# ==============================================================================
# WhatsApp Admin Verification Configuration
# ==============================================================================
NEXT_PUBLIC_ADMIN_WHATSAPP_NUMBER=+919207516227
WHATSAPP_ADMIN_NUMBER=+919207516227
